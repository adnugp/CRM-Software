rules_version = '2';

// Storage access mirrors firestore.rules: role and workspace come from the
// caller's /users/{uid} profile, and every company's files live under
// workspaces/{ws}/. Files are opened through download URLs, which carry their
// own access token, so clients can still open documents shared with them via
// a project. Direct reads and listing are limited to the workspace's staff.
service firebase.storage {
  match /b/{bucket}/o {

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function registered() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function inWs(ws) {
      return registered() && profile().get('workspaceId', '') == ws;
    }

    function isStaffOf(ws) {
      return inWs(ws) && profile().role in ['admin', 'manager', 'user'];
    }

    function isAdminOf(ws) {
      return inWs(ws) && profile().role == 'admin';
    }

    function underMB(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Mirrors writable() in firestore.rules: no uploads once a trial has ended
    // or the company is suspended.
    function writable(ws) {
      let w = firestore.get(/databases/(default)/documents/workspaces/$(ws)).data;
      let status = w.get('status', 'active');
      return status == 'active' || (status == 'trial' && request.time < w.trialEndsAt);
    }

    // Project, tender, registration and file-manager documents.
    match /workspaces/{ws}/documents/{fileName} {
      allow read: if isStaffOf(ws);
      allow delete: if isStaffOf(ws) && writable(ws);
      allow create, update: if isStaffOf(ws) && writable(ws) && underMB(50);
    }

    // Attachments on project tasks.
    match /workspaces/{ws}/task-attachments/{fileName} {
      allow read: if isStaffOf(ws);
      allow delete: if isStaffOf(ws) && writable(ws);
      allow create, update: if isStaffOf(ws) && writable(ws) && underMB(50);
    }

    // Company logo (Settings → Company).
    match /workspaces/{ws}/branding/{fileName} {
      allow read: if inWs(ws);
      allow create, update: if isAdminOf(ws) && writable(ws) && isImage() && underMB(2);
      allow delete: if isAdminOf(ws) && writable(ws);
    }

    // Profile pictures are stored as avatars/{uid}_{timestamp}_{name}.
    match /avatars/{fileName} {
      allow read: if registered();
      allow create, update: if registered()
        && fileName.matches(request.auth.uid + '_.*')
        && isImage()
        && underMB(5);
    }

    // Everything else is denied by default.
  }
}
