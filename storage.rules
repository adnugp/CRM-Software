rules_version = '2';

// Storage access mirrors firestore.rules: the role comes from /users/{uid}.
// Note: files are opened through download URLs, which carry their own access
// token, so these rules mainly control who can list, upload and replace files.
service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return request.auth == null ? ''
        : firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return role() in ['admin', 'manager', 'user'];
    }

    function underMB(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Project, tender, registration and file-manager documents.
    match /documents/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isStaff() && underMB(50);
      allow delete: if isStaff();
    }

    // Attachments on project tasks.
    match /task-attachments/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isStaff() && underMB(50);
      allow delete: if isStaff();
    }

    // Profile pictures are stored as avatars/{uid}_{timestamp}_{name}.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && fileName.matches(request.auth.uid + '_.*')
        && request.resource.contentType.matches('image/.*')
        && underMB(5);
    }

    // Everything else is denied by default.
  }
}
